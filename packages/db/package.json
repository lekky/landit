{
  "name": "@landit/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typegen": "node scripts/generate-types.mjs",
    "curation:worksheet": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/curation-worksheet.mts",
    "seed": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/seed.mts",
    "import:france": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/import-france.mts",
    "import:world": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/import-world.mts"
  },
  "dependencies": {
    "@landit/core": "workspace:*",
    "pocketbase": "0.27.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
