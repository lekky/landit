# apps/web — template only. Copy to `.env.local` and fill in locally.
# Never commit a filled-in copy; `.gitignore` keeps `.env*` out of the repo.

# Where the browser and the server talk to PocketBase.
# Local default matches `pnpm pb:dev`.
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Server-only override for the URL above. Set it when server code must reach
# PocketBase somewhere the browser is not told about — an internal address, or
# a seed run against the hosted box. Falls back to NEXT_PUBLIC_POCKETBASE_URL.
POCKETBASE_URL=

# Server-only. A PocketBase superuser used by admin server actions and the
# Stripe webhook (T15/T16). Leave blank locally until those tasks land.
#
# `pnpm --filter @landit/db seed` also uses these: seeding writes the trick
# library and the plans, which no rider token may do.
#
# T8's "I rode today" needs them now, not later, and fails *softly* without
# them — the rider is told to try again in a moment, forever (issue #62). So
# `GET /api/health` authenticates with this pair and answers 503 when it
# cannot, and the server warns once at startup when they are unset. If that
# endpoint is red on a deployment, this is the first thing to check.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# The Mapbox token the spots map draws with (plan §1: Mapbox, provisional).
#
# Public by design — a Mapbox access token is sent by the browser on every tile
# request, so it cannot be a secret and is not treated as one. What keeps it
# ours is the URL restriction set on it in the Mapbox account: scope the token
# to the product's own domains, and to public styles and tiles only. A token
# with no restrictions is somebody else's map bill.
#
# **Leave it blank and the spots screen still works.** The list, the search, the
# filters and "add a spot" need no map at all; the map panel says in one line
# that it is waiting on a key rather than rendering a broken canvas. There is no
# account behind this yet (docs/infrastructure.md), so blank is the honest
# default for every checkout and for CI.
#
# Nothing about the *rider's* location goes anywhere near this. Spots carry
# coordinates; riders do not (plan §6.4, standard 10).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only. Is the site open to the public, or does every URL get the
# holding page? Enforced in `src/proxy.ts`; `src/app/robots.ts` reads the same
# value and tells crawlers to index nothing while it is off.
#
# Accepts true/1/yes/on and false/0/no/off. Anything else — including a typo —
# counts as "not live", and so does leaving it unset in production: forgetting
# the flag has to fail towards the holding page, never towards publishing an
# unfinished product.
#
# **Unset in development means live**, so `pnpm dev` and the e2e suite need
# nothing here. Set it to `false` locally when you want to see the holding page.
#
# Deliberately not NEXT_PUBLIC_: it is read on the server per request, so going
# live is this value plus a restart — no rebuild. Making it NEXT_PUBLIC_ would
# bake it into the browser bundle and break that.
LANDIT_SITE_LIVE=

# Server-only. The escape hatch past the holding page: open any URL with
# `?preview=<this value>` and the gate lets you through for 30 days (an
# httpOnly cookie; the key never stays in the address bar).
#
# Leave it blank and the bypass is switched off entirely — a missing key locks
# the door, it does not unlock it. Generate a long random one; it is a shared
# password for the unreleased site, not a per-person credential.
LANDIT_PREVIEW_KEY=

# --------------------------------------------------------------- payments --
#
# **There is no Stripe account yet, and none of these has ever held a real
# value in this repo.** Creating the account, its products and its prices is
# the owner's, in their own browser — secrets never enter the repo, and an
# agent session never handles an API key. See the handover issue for the exact
# products and prices to create.
#
# Leave every one of them blank and the product still works: `/plans` renders
# all three cards with the real prices (they come from our own `plans`
# records, never from Stripe), the checkout says upgrading is not switched on
# yet, and the webhook answers 503 so a misconfigured deployment shows up as
# failing rather than looking delivered.
#
# Server-only, all of them. None is NEXT_PUBLIC_, and none may become one:
# the secret key and the webhook secret would be inlined into the browser
# bundle (LESSONS §5), and the price ids have no business being there either.

# The secret key from the Stripe dashboard. `sk_test_…` locally, `sk_live_…`
# in production — and never the two mixed up with the webhook secret below.
STRIPE_SECRET_KEY=

# The signing secret for the endpoint pointed at POST /api/stripe/webhook
# (`whsec_…`). It is what makes the webhook refuse a forged event, so a
# deployment without it does not accept events at all rather than accepting
# them unverified.
STRIPE_WEBHOOK_SECRET=

# The four recurring prices, one per plan per period (plan §6.7):
#   Shredder  £3.99/mo   £39.99/yr
#   Legend    £6.99/mo   £69.99/yr
# The **plan** a rider ends up on is decided by our own `plans` record, not by
# which price they bought — these ids only say what Stripe should charge. That
# is why repricing in Stripe cannot move anybody between tiers.
STRIPE_PRICE_SHREDDER_MONTHLY=
STRIPE_PRICE_SHREDDER_YEARLY=
STRIPE_PRICE_LEGEND_MONTHLY=
STRIPE_PRICE_LEGEND_YEARLY=

# Where Stripe sends a payer back to, and where the guardian-upgrade email
# points. PocketBase reads the same variable for the consent links, so the two
# cannot disagree about which host this deployment is. Defaults to
# http://localhost:3000.
LANDIT_APP_URL=

# ------------------------------------------------------------ error reports --
#
# Sentry (T18). **Leave both blank and reporting is switched off entirely** —
# the SDK never initialises, nothing is sent, and every checkout and CI run is
# in that state today. There is no Sentry organisation or project yet: creating
# one is the owner's, in their own browser, and plan §6.5 lists Sentry among the
# processors that still need an Article 28 contract and a ROPA entry before a
# real DSN goes anywhere near a deployment.
#
# A DSN is a URL, not a credential — the browser sends it with every event, so
# it cannot be secret and is not treated as one. What it does *not* carry is
# permission to read anything back.
#
# What we send is decided in `src/lib/sentry.ts` and asserted in its test:
# no `sendDefaultPii` (so no IP addresses, cookies or usernames), no session
# replay, no profiling, tracing off, and the query string stripped from every
# URL an event carries — `/report?id=<rider id>` must not become a rider id in
# a third party's logs.
NEXT_PUBLIC_SENTRY_DSN=

# Which deployment an event came from — `production`, `staging`, whatever the
# box is called. Falls back to NODE_ENV. Not a secret and not a rider fact.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
