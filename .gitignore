node_modules/
dist/
build/
.expo/
.next/
coverage/

# Regenerated by every `next build` / `next dev`, and its contents differ
# between the two. Committing it breaks a typecheck on a fresh clone.
next-env.d.ts

.env
.env.*
!.env.example

# Local PocketBase: the downloaded binary and the scratch database.
# The schema lives in pocketbase/migrations/ and is committed.
pocketbase/.bin/
# The e2e run gets its own database on its own port, so a `pnpm e2e` never
# writes test riders into the one you are developing against (LESSONS §1), and
# a parallel session gets a third. The glob covers all of them.
pocketbase/.pb_*/

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/

# Parallel agent sessions work in git worktrees under here (see CLAUDE.md).
.claude/worktrees/

*.log
npm-debug.log*
yarn-error.log*
*.tsbuildinfo

.DS_Store
Thumbs.db
.vscode/
.idea/

# Copied from @landit/ui-web at dev/build time by apps/web/scripts/sync-avatars.mjs.
# The PNGs live once, in the design system package.
apps/web/public/avatars/
apps/web/public/maplibre/
apps/web/public/sports/
apps/web/public/stickers/

# The Claude Code preview-server config. Machine-specific by construction — it
# stores an absolute path to the local pnpm shim (on this box, a corepack path
# under `C:/Program Files/nodejs/`), so a committed copy would be wrong for
# everyone else and wrong on any other OS. Same category as `.vscode/`.
#
# Ignored by name rather than ignoring `.claude/` wholesale: the directory is
# also where a shared agent or skill definition would live, and those should be
# committable. `.claude/worktrees/` is already ignored above.
.claude/launch.json
