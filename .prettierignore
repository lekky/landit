# Prettier owns code and config. Markdown is hand-authored prose — the plan, the
# handoff, CLAUDE.md — where deliberate line breaks and compact tables carry
# meaning, and Prettier's table padding mangles them (it pads to character count,
# and this project's prose is full of £, — and ·). Formatting is not enforced
# there; care is.
**/*.md

# Email HTML, transcribed from the design pack. Whitespace between table cells
# is not free here — several clients render a newline between two <td>s as a
# visible gap, and Prettier reflows exactly there. These files are pasted whole
# into PocketBase's settings, so what is in the file is what a rider receives.
pocketbase/templates/*.html

# The received design pack is reference, not our code. Never reformat it.
design-handoff/

# Generated by `next build`.
apps/web/next-env.d.ts

# Generated from `pocketbase/migrations/` by `pnpm --filter @landit/db typegen`.
# Its drift test compares the file on disk against the generator's output byte
# for byte, so anything that rewrites it — Prettier included — makes the check
# fail on a file nobody edited.
packages/db/src/generated/

# MapLibre's worker, copied into place by a build step. Vendor code, and the
# drift would be reformatted on every build anyway.
apps/web/public/maplibre/

node_modules/
.next/
dist/
build/
coverage/
playwright-report/
test-results/
pnpm-lock.yaml
pocketbase/.bin/
pocketbase/.pb_*/
