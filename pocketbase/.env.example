# pocketbase/ — template only. Nothing here is ever filled in and committed.
#
# Local development needs none of these: `pnpm pb:dev` serves a scratch database
# with no email and no object storage. They exist so the shape is written down
# before T2/T4 need them, and so the hosted instance is configured from a list
# rather than from memory.

# Transactional email (Resend SMTP) — auth, password reset, guardian consent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=Land It

# Clip storage: Cloudflare R2 through PocketBase's S3 backend. Private bucket;
# clips are delivered by short-lived file token only, never publicly.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET=
